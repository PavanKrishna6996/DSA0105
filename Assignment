#include <iostream>
#include <iomanip>
#include <string>
#include <vector>
#include <algorithm>
#include <limits>

using namespace std;

// ---------------------------------------------------------------------
// Enumerations
// ---------------------------------------------------------------------
enum Priority { CRITICAL = 1, EMERGENCY = 2, URGENT = 3, STABLE = 4 };
enum CaseStatus { WAITING, UNDER_TREATMENT, STABILIZED, TRANSFERRED, COMPLETED };
enum ResourceStatus { AVAILABLE, ALLOCATED };

string priorityToString(Priority p) {
    switch (p) {
        case CRITICAL:  return "Critical";
        case EMERGENCY: return "Emergency";
        case URGENT:    return "Urgent";
        case STABLE:    return "Stable";
    }
    return "Unknown";
}

string caseStatusToString(CaseStatus s) {
    switch (s) {
        case WAITING:         return "WAITING";
        case UNDER_TREATMENT: return "UNDER TREATMENT";
        case STABILIZED:      return "STABILIZED";
        case TRANSFERRED:     return "TRANSFERRED";
        case COMPLETED:       return "COMPLETED";
    }
    return "UNKNOWN";
}

string resourceStatusToString(ResourceStatus s) {
    return (s == AVAILABLE) ? "Available" : "Allocated";
}

// ---------------------------------------------------------------------
// Small input helpers
// ---------------------------------------------------------------------
int readInt(const string& prompt) {
    int value;
    while (true) {
        cout << prompt;
        if (cin >> value) {
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
            return value;
        }
        cout << "Invalid input. Please enter a number.\n";
        cin.clear();
        cin.ignore(numeric_limits<streamsize>::max(), '\n');
    }
}

string readLine(const string& prompt) {
    string value;
    cout << prompt;
    getline(cin, value);
    return value;
}

// =======================================================================
// CLASS: Patient  (CO2 - class, object, member functions)
// =======================================================================
class Patient {
private:
    int id;
    string name;
    int age;
    string condition;
    string contact;

public:
    Patient() : id(0), age(0) {}
    Patient(int id, string name, int age, string condition, string contact)
        : id(id), name(move(name)), age(age),
          condition(move(condition)), contact(move(contact)) {}

    int getId() const { return id; }
    string getName() const { return name; }
    int getAge() const { return age; }
    string getCondition() const { return condition; }
    string getContact() const { return contact; }

    void display() const {
        cout << left << setw(8) << id << setw(20) << name << setw(6) << age
             << setw(20) << condition << setw(15) << contact << "\n";
    }
};

// =======================================================================
// ABSTRACT BASE CLASS: Resource   (CO4 - abstraction, inheritance, virtual)
// =======================================================================
class Resource {
protected:
    string id;
    string subType;     // e.g. "Advanced Life Support", "ICU Bed"
    string location;
    ResourceStatus status;

public:
    Resource(string id, string subType, string location)
        : id(move(id)), subType(move(subType)), location(move(location)),
          status(AVAILABLE) {}

    virtual ~Resource() {}

    string getId() const { return id; }
    ResourceStatus getStatus() const { return status; }
    void setStatus(ResourceStatus s) { status = s; }

    // Pure virtual functions -> Resource is an abstract class
    virtual string getCategory() const = 0;
    virtual void display() const = 0;
};

// -------------------- Derived Resource classes ------------------------
class Ambulance : public Resource {
public:
    Ambulance(string id, string subType, string location)
        : Resource(move(id), move(subType), move(location)) {}

    string getCategory() const override { return "Ambulance"; }

    void display() const override {
        cout << left << setw(12) << getCategory() << setw(10) << id
             << setw(24) << subType << setw(16) << location
             << resourceStatusToString(status) << "\n";
    }
};

class EmergencyBed : public Resource {
public:
    EmergencyBed(string id, string subType, string location)
        : Resource(move(id), move(subType), move(location)) {}

    string getCategory() const override { return "Emergency Bed"; }

    void display() const override {
        cout << left << setw(12) << "Bed" << setw(10) << id
             << setw(24) << subType << setw(16) << location
             << resourceStatusToString(status) << "\n";
    }
};

class MedicalEquipment : public Resource {
public:
    MedicalEquipment(string id, string subType, string location)
